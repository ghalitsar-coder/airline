          ]
        },
        {
          "name": "Internal",
          "item": [
            {
              "name": "Validate Passenger",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "X-Service-Key", "value": "{{service_key}}" }
                ],
                "url": "{{passenger_base_url}}/v1/internal/passengers/:id/validate",
                "description": "Service-to-service passenger validation. Requires X-Service-Key."
              }
            }
          ]
        },
        {
          "name": "Protected",
          "item": [
            {
              "name": "Get Passenger",
              "request": {
                "method": "GET",
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    { "key": "token", "value": "{{jwt_token}}", "type": "string" }
                  ]
                },
                "header": [],
                "url": "{{passenger_base_url}}/v1/passengers/:id",
                "description": "Requires a valid bearer access token."
              }
            },
            {
              "name": "Update Passenger",
              "request": {
                "method": "PUT",
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    { "key": "token", "value": "{{jwt_token}}", "type": "string" }
                  ]
                },
                "header": [],
                "url": "{{passenger_base_url}}/v1/passengers/:id",
                "description": "Requires a valid bearer access token. Add JSON body in Postman before sending."
