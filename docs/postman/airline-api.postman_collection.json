            },
            {
              "name": "Upload Document File",
              "request": {
                "method": "POST",
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    { "key": "token", "value": "{{jwt_token}}", "type": "string" }
                  ]
                },
                "header": [],
                "url": "{{passenger_base_url}}/v1/passengers/:id/documents/upload",
                "description": "Upload a passenger document file. Use form-data in Postman."
