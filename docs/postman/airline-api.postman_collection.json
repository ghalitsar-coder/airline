            },
            {
              "name": "Get Documents",
              "request": {
                "method": "GET",
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    { "key": "token", "value": "{{jwt_token}}", "type": "string" }
                  ]
                },
                "header": [],
                "url": "{{passenger_base_url}}/v1/passengers/:id/documents",
                "description": "List passenger documents."
